# Constellation backend — systemd user service
#
# Install:
#   cp constellation.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now constellation
#
# Verify:
#   systemctl --user status constellation
#   journalctl --user -u constellation -f

[Unit]
Description=Constellation backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/matt/dev/constellation/backend
ExecStart=/home/matt/dev/constellation/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
