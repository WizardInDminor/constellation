# =============================================================================
# Constellation — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values. The `.env` file is
# gitignored. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Where the SQLite file lives. Created on first run if it doesn't exist.
DB_PATH=./data/constellation.db

# FastAPI server bind. Defaults are fine for local dev.
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of origins allowed by CORS. Include the Next.js dev URL.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# AI providers — cloud (default mode)
# -----------------------------------------------------------------------------

# Voyage AI — used for embeddings.
# Get a key at https://www.voyageai.com
VOYAGE_API_KEY=

# Anthropic — used for generation.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# AI providers — local (optional, for Phase 7 / offline mode)
# -----------------------------------------------------------------------------

# Base URL for the Ollama daemon. Default is the standard Ollama install.
OLLAMA_BASE_URL=http://localhost:11434

# Default local models. Active provider/model is selected at runtime via the
# `config` table; these are only fallbacks for the initial bootstrap.
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_GEN_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser. Do not put
# secrets here.

# Where the Next.js client should call the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000